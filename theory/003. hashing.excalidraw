      "isDeleted": false,
      "boundElements": null,
      "updated": 1772699034755,
      "link": null,
      "locked": false,
      "text": "What is collision & How the hashing works:\nHashing is done using several methods. Among them, the three most common ones are\n\nDivision method\nFolding method\nMid-Square method",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is collision & How the hashing works:\nHashing is done using several methods. Among them, the three most common ones are\n\nDivision method\nFolding method\nMid-Square method",
      "autoResize": true,
      "lineHeight": 1.25
    },
