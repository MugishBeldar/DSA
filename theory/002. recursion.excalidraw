    {
      "id": "NlX4Tw01UvngIIw4TK1jP",
      "type": "text",
      "x": 316.4576141834259,
      "y": 4264.274619579315,
      "width": 350.3596496582031,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 431299443,
      "version": 64,
      "versionNonce": 1807716221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772174285708,
      "link": null,
      "locked": false,
      "text": "Call Execution Flow\nsumOfNNum(5, 0)\n├─ n=5, sum=0\n├─ Check: 5 ≠ 0 ✓\n├─ sum = 0 + 5 = 5\n└─ Call: sumOfNNum(4, 5)\n   │\n   ├─ n=4, sum=5\n   ├─ Check: 4 ≠ 0 ✓\n   ├─ sum = 5 + 4 = 9\n   └─ Call: sumOfNNum(3, 9)\n      │\n      ├─ n=3, sum=9\n      ├─ Check: 3 ≠ 0 ✓\n      ├─ sum = 9 + 3 = 12\n      └─ Call: sumOfNNum(2, 12)\n         │\n         ├─ n=2, sum=12\n         ├─ Check: 2 ≠ 0 ✓\n         ├─ sum = 12 + 2 = 14\n         └─ Call: sumOfNNum(1, 14)\n            │\n            ├─ n=1, sum=14\n            ├─ Check: 1 ≠ 0 ✓\n            ├─ sum = 14 + 1 = 15\n            └─ Call: sumOfNNum(0, 15)\n               │\n               ├─ n=0, sum=15\n               ├─ Check: 0 == 0 ✓\n               └─ RETURN: 15",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Call Execution Flow\nsumOfNNum(5, 0)\n├─ n=5, sum=0\n├─ Check: 5 ≠ 0 ✓\n├─ sum = 0 + 5 = 5\n└─ Call: sumOfNNum(4, 5)\n   │\n   ├─ n=4, sum=5\n   ├─ Check: 4 ≠ 0 ✓\n   ├─ sum = 5 + 4 = 9\n   └─ Call: sumOfNNum(3, 9)\n      │\n      ├─ n=3, sum=9\n      ├─ Check: 3 ≠ 0 ✓\n      ├─ sum = 9 + 3 = 12\n      └─ Call: sumOfNNum(2, 12)\n         │\n         ├─ n=2, sum=12\n         ├─ Check: 2 ≠ 0 ✓\n         ├─ sum = 12 + 2 = 14\n         └─ Call: sumOfNNum(1, 14)\n            │\n            ├─ n=1, sum=14\n            ├─ Check: 1 ≠ 0 ✓\n            ├─ sum = 14 + 1 = 15\n            └─ Call: sumOfNNum(0, 15)\n               │\n               ├─ n=0, sum=15\n               ├─ Check: 0 == 0 ✓\n               └─ RETURN: 15",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7BaAcXT8ctLxU7LnYVPSU",
      "type": "text",
      "x": 836.6407220363617,
      "y": 4277.788547992706,
      "width": 507.39947509765625,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
