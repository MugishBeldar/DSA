    },
    {
      "id": "7q5JlpSFMpoWFvdYHtD4u",
      "type": "text",
      "x": 371.4137086868286,
      "y": 5171.689211845398,
      "width": 420.91961669921875,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 859006195,
      "version": 17,
      "versionNonce": 1583373021,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772175144758,
      "link": null,
      "locked": false,
      "text": "Call Execution Flow (Building up the stack)\nfactorial(5)\n├─ num=5, Check: 5 ≠ 0 ✓\n├─ Need: 5 * factorial(4)\n└─ WAIT for factorial(4)...\n   │\n   ├─ num=4, Check: 4 ≠ 0 ✓\n   ├─ Need: 4 * factorial(3)\n   └─ WAIT for factorial(3)...\n      │\n      ├─ num=3, Check: 3 ≠ 0 ✓\n      ├─ Need: 3 * factorial(2)\n      └─ WAIT for factorial(2)...\n         │\n         ├─ num=2, Check: 2 ≠ 0 ✓\n         ├─ Need: 2 * factorial(1)\n         └─ WAIT for factorial(1)...\n            │\n            ├─ num=1, Check: 1 == 1 ✓\n            ├─ BASE CASE\n            └─ RETURN: 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Call Execution Flow (Building up the stack)\nfactorial(5)\n├─ num=5, Check: 5 ≠ 0 ✓\n├─ Need: 5 * factorial(4)\n└─ WAIT for factorial(4)...\n   │\n   ├─ num=4, Check: 4 ≠ 0 ✓\n   ├─ Need: 4 * factorial(3)\n   └─ WAIT for factorial(3)...\n      │\n      ├─ num=3, Check: 3 ≠ 0 ✓\n      ├─ Need: 3 * factorial(2)\n      └─ WAIT for factorial(2)...\n         │\n         ├─ num=2, Check: 2 ≠ 0 ✓\n         ├─ Need: 2 * factorial(1)\n         └─ WAIT for factorial(1)...\n            │\n            ├─ num=1, Check: 1 == 1 ✓\n            ├─ BASE CASE\n            └─ RETURN: 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ysRZVwTy26xtcozcna8TM",
      "type": "text",
      "x": 944.2380568981171,
      "y": 5132.0317306518555,
      "width": 437.87957763671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
