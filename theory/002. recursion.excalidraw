      "seed": 203603123,
      "version": 29,
      "versionNonce": 1205445203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772174370599,
      "link": null,
      "locked": false,
      "text": "Call Stack Visualization\n\nStep 1-5: Growing Stack\n┌─────────────────────┐\n│ sumOfNNum(5, 0)     │  ← Waiting for result\n│ sumOfNNum(4, 5)     │  ← Waiting for result\n│ sumOfNNum(3, 9)     │  ← Waiting for result\n│ sumOfNNum(2, 12)    │  ← Waiting for result\n│ sumOfNNum(1, 14)    │  ← Waiting for result\n│ sumOfNNum(0, 15)    │  ← BASE CASE: Return 15\n└─────────────────────┘\n\n\nStep 6: Unwinding (Returning)\n                          15\n                       ↗\n                    15\n                 ↗\n              15\n           ↗\n        15\n     ↗\n  15\n\nResult: 15",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Call Stack Visualization\n\nStep 1-5: Growing Stack\n┌─────────────────────┐\n│ sumOfNNum(5, 0)     │  ← Waiting for result\n│ sumOfNNum(4, 5)     │  ← Waiting for result\n│ sumOfNNum(3, 9)     │  ← Waiting for result\n│ sumOfNNum(2, 12)    │  ← Waiting for result\n│ sumOfNNum(1, 14)    │  ← Waiting for result\n│ sumOfNNum(0, 15)    │  ← BASE CASE: Return 15\n└─────────────────────┘\n\n\nStep 6: Unwinding (Returning)\n                          15\n                       ↗\n                    15\n                 ↗\n              15\n           ↗\n        15\n     ↗\n  15\n\nResult: 15",
      "autoResize": true,
      "lineHeight": 1.25
    },
