    },
    {
      "id": "iHUiAKvO-SW8Z36m6XEFS",
      "type": "text",
      "x": 946.2380568981171,
      "y": 5188.0317306518555,
      "width": 589.87939453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 1864774547,
      "version": 40,
      "versionNonce": 1746100765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772175177369,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────┐\n│ factorial(5)  [WAITING: 5 * ?]  │  ← Top (called first)\n│ factorial(4)  [WAITING: 4 * ?]  │\n│ factorial(3)  [WAITING: 3 * ?]  │\n│ factorial(2)  [WAITING: 2 * ?]  │\n│ factorial(1)  [RETURN: 1]       │  ← Bottom (called last)\n└─────────────────────────────────┘\n     Stack has 5 levels!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────┐\n│ factorial(5)  [WAITING: 5 * ?]  │  ← Top (called first)\n│ factorial(4)  [WAITING: 4 * ?]  │\n│ factorial(3)  [WAITING: 3 * ?]  │\n│ factorial(2)  [WAITING: 2 * ?]  │\n│ factorial(1)  [RETURN: 1]       │  ← Bottom (called last)\n└─────────────────────────────────┘\n     Stack has 5 levels!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8GEzqcs1Px21CgwvXFMum",
      "type": "text",
      "x": 1615.5290820598602,
      "y": 5135.0317306518555,
      "width": 399.099609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 195609363,
      "version": 33,
      "versionNonce": 2135314003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772175193000,
      "link": null,
      "locked": false,
      "text": "Return & Compute (Unwinding the stack)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Return & Compute (Unwinding the stack)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HQ_xPx9f-H_xhUcjBmIhm",
      "type": "text",
      "x": 1616.5290820598602,
      "y": 5183.0317306518555,
      "width": 473.83941650390625,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 1558511901,
      "version": 31,
      "versionNonce": 2062354835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772175217850,
      "link": null,
      "locked": false,
      "text": "Step 1: factorial(1) returns 1\n┌──────────────────────────────┐\n│ factorial(2) [2 * 1 = 2]     │ ← Compute now\n│ factorial(3) [WAITING: 3 * ?]│\n│ factorial(4) [WAITING: 4 * ?]│\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 2: factorial(2) returns 2\n┌──────────────────────────────┐\n│ factorial(3) [3 * 2 = 6]     │ ← Compute now\n│ factorial(4) [WAITING: 4 * ?]│\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 3: factorial(3) returns 6\n┌──────────────────────────────┐\n│ factorial(4) [4 * 6 = 24]    │ ← Compute now\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 4: factorial(4) returns 24\n┌──────────────────────────┐\n│ factorial(5) [5 * 24 = 120] │ ← Compute now\n└──────────────────────────┘\n\nStep 5: factorial(5) returns 120\nResult: 120",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1: factorial(1) returns 1\n┌──────────────────────────────┐\n│ factorial(2) [2 * 1 = 2]     │ ← Compute now\n│ factorial(3) [WAITING: 3 * ?]│\n│ factorial(4) [WAITING: 4 * ?]│\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 2: factorial(2) returns 2\n┌──────────────────────────────┐\n│ factorial(3) [3 * 2 = 6]     │ ← Compute now\n│ factorial(4) [WAITING: 4 * ?]│\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 3: factorial(3) returns 6\n┌──────────────────────────────┐\n│ factorial(4) [4 * 6 = 24]    │ ← Compute now\n│ factorial(5) [WAITING: 5 * ?]│\n└──────────────────────────────┘\n\nStep 4: factorial(4) returns 24\n┌──────────────────────────┐\n│ factorial(5) [5 * 24 = 120] │ ← Compute now\n└──────────────────────────┘\n\nStep 5: factorial(5) returns 120\nResult: 120",
      "autoResize": true,
      "lineHeight": 1.25
    },
