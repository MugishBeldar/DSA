      "text": "Call Stack at Maximum (All functions waiting)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Call Stack at Maximum (All functions waiting)",
      "autoResize": true,
