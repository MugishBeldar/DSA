      "index": "b0c",
      "roundness": null,
      "seed": 1145241083,
      "version": 1238,
      "versionNonce": 863188349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772780263091,
      "link": null,
      "locked": false,
      "text": "-Merge Sort is a \"Divide and Conquer\" algorithm that works like organizing \na messy deck of cards by:\n-Splitting the deck into smaller piles\n-Sorting each small pile\n-Merging sorted piles back together",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-Merge Sort is a \"Divide and Conquer\" algorithm that works like organizing \na messy deck of cards by:\n-Splitting the deck into smaller piles\n-Sorting each small pile\n-Merging sorted piles back together",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_WJdJ4zBKxiOjM5AUlqpn",
      "type": "text",
      "x": 4665.978178684914,
      "y": 238.2050654053267,
      "width": 934.9989013671875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0cV",
      "roundness": null,
      "seed": 1513611259,
      "version": 1315,
      "versionNonce": 2009037755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757829647680,
      "link": null,
      "locked": false,
      "text": "- quick sort is a divide and conquer algorithm that works like organizing a group by \npicking a leader (pivot) and arranging everyone\n- smaller peopple to the left of the leader \n- larger people to the right of the leader\n- then recursively organize each group\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- quick sort is a divide and conquer algorithm that works like organizing a group by \npicking a leader (pivot) and arranging everyone\n- smaller peopple to the left of the leader \n- larger people to the right of the leader\n- then recursively organize each group\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6rY9BUPfmeTfoQBQHZ5Gu",
      "type": "text",
      "x": 476.07596186641877,
      "y": 4932.100760306092,
      "width": 461.9994201660156,
      "height": 25,
