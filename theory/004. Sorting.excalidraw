    {
      "id": "Lx8aEC7KsHZ3hbcOnjqTA",
      "type": "text",
      "x": 1324.4712767184571,
      "y": 256.5538388630848,
      "width": 758.9990234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 164928891,
      "version": 580,
      "versionNonce": 1903666491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757784372692,
      "link": null,
      "locked": false,
      "text": "- Selection sort is a simple comparision-based sorting algorithm that\nwork by selection the smallest element from the unsorted portion and\nplacing it at the begining.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Selection sort is a simple comparision-based sorting algorithm that\nwork by selection the smallest element from the unsorted portion and\nplacing it at the begining.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rBH-oDstX_5p1UTUAfY8i",
      "type": "text",
      "x": 1324.6826104057143,
      "y": 338.9748875084017,
      "width": 362.9995422363281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1212926747,
      "version": 330,
      "versionNonce": 1146730235,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757784428577,
      "link": null,
      "locked": false,
      "text": "Trick: MIN - SWAP - MOVE - REPEAT",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trick: MIN - SWAP - MOVE - REPEAT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9DdTQeB8XmD0YhyM9fVxN",
      "type": "text",
      "x": 1324.7234565211234,
      "y": 369.50242515589696,
      "width": 659.9991455078125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 262812891,
      "version": 259,
      "versionNonce": 1042421371,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757784540983,
      "link": null,
      "locked": false,
      "text": "Algorithm Steps\n1. start from the first position\n2. find the smallest element in the remaining unsorted array\n3. swap it with the element at current position\n4. move to the next position\n5. repeat untill array is sorted",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm Steps\n1. start from the first position\n2. find the smallest element in the remaining unsorted array\n3. swap it with the element at current position\n4. move to the next position\n5. repeat untill array is sorted",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dGYTNpt0oNw_QfAwCmZrv",
      "type": "text",
      "x": 1325.124991060113,
      "y": 528.9181831975026,
      "width": 263.9996337890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 1401209947,
      "version": 466,
      "versionNonce": 1161129627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757784650091,
      "link": null,
      "locked": false,
      "text": "Time complexity:- O(n^2)\nSpace complexity:- O(1)\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time complexity:- O(n^2)\nSpace complexity:- O(1)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
