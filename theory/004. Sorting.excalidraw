      "locked": false,
      "text": "Trick: PIVOT - PARTITION - RECURSE - REPEAT",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trick: PIVOT - PARTITION - RECURSE - REPEAT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dOFmBglX45CPj8qQsFH9w",
      "type": "text",
      "x": 4672.396312052801,
      "y": 402.09625065290464,
      "width": 494.9993896484375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 7056027,
      "version": 2025,
      "versionNonce": 313490133,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757829647680,
      "link": null,
      "locked": false,
      "text": "Angorithm\n- choose: pick a pivot element\n- partition: arrangge element sarround pivot \n    - smaller elements -> left side\n    - larger elements -> right side\n- recurse: apply quick sort to both sides\n- combine: no explicit combining needed!",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Angorithm\n- choose: pick a pivot element\n- partition: arrangge element sarround pivot \n    - smaller elements -> left side\n    - larger elements -> right side\n- recurse: apply quick sort to both sides\n- combine: no explicit combining needed!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PepecXImDbYDz7weYqINw",
      "type": "text",
      "x": 4671.483532897892,
      "y": 718.3996126248257,
      "width": 395.9994812011719,
      "height": 25,
      "angle": 0,
