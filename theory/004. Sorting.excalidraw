    {
      "id": "A0ISTp_vF9iQnmfp1Xwt8",
      "type": "text",
      "x": 502.8209741739596,
      "y": 2889.973993480341,
      "width": 835.9989624023438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
