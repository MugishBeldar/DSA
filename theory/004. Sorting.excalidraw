    {
      "id": "5klzQGKSdv5_cSItfX5Gs",
      "type": "text",
      "x": 477.08491368565274,
      "y": 4802.790911770216,
      "width": 824.9990234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
