    {
      "id": "pqJfma88qLrHrjfp3Y69d",
      "type": "text",
      "x": 548.6986875715625,
      "y": 1637.5420824176476,
      "width": 461.9993896484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
