      "isDeleted": false,
      "boundElements": [],
      "updated": 1772780263091,
      "link": null,
      "locked": false,
      "text": "Trick: DIVIDE - CONQUER - COMBINE - REPEAT",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trick: DIVIDE - CONQUER - COMBINE - REPEAT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7FJyjzb48dZCuSBk0H9dE",
      "type": "text",
      "x": 479.5782343825522,
      "y": 4962.087216762023,
      "width": 538.999267578125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1141458229,
      "version": 1996,
      "versionNonce": 1123531325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772780263091,
      "link": null,
      "locked": false,
      "text": "Algorithm \n1. DIVIDE: split array into two halves\n2. CONQUER: recursively sort both halves\n3. COMBINE: merge the sorted halves bach together",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm \n1. DIVIDE: split array into two halves\n2. CONQUER: recursively sort both halves\n3. COMBINE: merge the sorted halves bach together",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w7H7YPFh7tz_lejKgHD3j",
      "type": "text",
      "x": 477.5901205005016,
      "y": 5078.409389211818,
      "width": 516.999267578125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 123901781,
      "version": 1187,
      "versionNonce": 1474259613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772780263091,
      "link": null,
      "locked": false,
      "text": "Time complexity:-\nBest, average, worst - O(nlogn)\nSpace complexity:- O(1) due to temporary arrays\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time complexity:-\nBest, average, worst - O(nlogn)\nSpace complexity:- O(1) due to temporary arrays\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SDEZa-u9amDYxI_xYCeTq",
      "type": "text",
      "x": 4669.983009290207,
      "y": 584.9825599192599,
      "width": 571.9992065429688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
