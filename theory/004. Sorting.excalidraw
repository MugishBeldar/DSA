      "isDeleted": false,
      "boundElements": [],
      "updated": 1772779228667,
      "link": null,
      "locked": false,
      "text": "- Insertion Sort works like sorting playing cards in your hand. You pick one\ncard at a time and insert it into its correct position among the already \nsorted cards.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Insertion Sort works like sorting playing cards in your hand. You pick one\ncard at a time and insert it into its correct position among the already \nsorted cards.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dxFhbbHEZ8GSfLehaiB44",
      "type": "text",
      "x": 502.74863312430523,
      "y": 2968.1154317869696,
      "width": 516.9993896484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 819826075,
      "version": 997,
      "versionNonce": 1411523741,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772779228667,
      "link": null,
      "locked": false,
      "text": "Trick: PICK - COMPARE - SHIFT - INSERT - REPEAT",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trick: PICK - COMPARE - SHIFT - INSERT - REPEAT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VwZu-IQC4G1m80gPdq8_b",
      "type": "text",
      "x": 503.850162368641,
      "y": 2996.605650338476,
      "width": 461.9993591308594,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 763542325,
      "version": 1872,
      "versionNonce": 17664253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772779228667,
      "link": null,
      "locked": false,
      "text": "Algorithm \n1. Start from the second element (Index 1)\n2. Pick the current element (Key)\n3. Compare with elements before it\n4. Shift larger elements to the right\n5. Insert the key in its correct position\n6. Repeat for all elements ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm \n1. Start from the second element (Index 1)\n2. Pick the current element (Key)\n3. Compare with elements before it\n4. Shift larger elements to the right\n5. Insert the key in its correct position\n6. Repeat for all elements ",
      "autoResize": true,
      "lineHeight": 1.25
    },
