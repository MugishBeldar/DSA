      "versionNonce": 47411573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757829647680,
      "link": null,
      "locked": false,
      "text": "Time complexity:-\nBest, average - O(nlogn)\nWorst - O(n^2) when pivot is always smallest/largest\nSpace complexity:- O(log n) recursion stack\nin place sorting",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time complexity:-\nBest, average - O(nlogn)\nWorst - O(n^2) when pivot is always smallest/largest\nSpace complexity:- O(log n) recursion stack\nin place sorting",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t8ATS5n4pweo0QlrH0Ixa",
      "type": "text",
      "x": 4670.067291537025,
      "y": 373.10339863449667,
      "width": 472.9994201660156,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
