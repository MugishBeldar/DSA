      "isDeleted": false,
      "boundElements": [],
      "updated": 1757829647680,
      "link": null,
      "locked": false,
      "text": "- because its typically faster in practice than other algorithms due to \n    - good cache locality\n    - in place sorting\n    - low contant factors",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- because its typically faster in practice than other algorithms due to \n    - good cache locality\n    - in place sorting\n    - low contant factors",
      "autoResize": true,
      "lineHeight": 1.25
    },
