      "roundness": null,
      "seed": 1143454568,
      "version": 3,
      "versionNonce": 682492264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772453954563,
      "link": null,
      "locked": false,
      "text": "========================================\nDOUBLY LINKED LIST — SHIFT INTUITION\n========================================\n\n\nCASE 1: EMPTY LIST\n------------------\n\nBefore:\n\nhead → X\ntail → X\n\n\nOperation:\nshift()\n\n\nAfter:\n\nhead → X\ntail → X\n\nreturn → undefined\n\n\n\n========================================\n\n\nCASE 2: SINGLE NODE\n------------------\n\nBefore:\n\nhead        tail\n |           |\n v           v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\nOperation:\nshift()\n\n\nSteps:\ntemp = head\nhead = X\ntail = X\n\n\nAfter:\n\nhead → X\ntail → X\n\n\nReturned Node:\n\ntemp\n |\n v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\n\n========================================\n\n\nCASE 3: MULTIPLE NODES\n---------------------\n\nBefore:\n\nhead                        tail\n |                           |\n v                           v\n+--------+    +--------+    +--------+\n| val:10 |    | val:20 |    | val:30 |\n| prev:X |<---| prev:10|<---| prev:20|\n| next:20|--->| next:30|--->| next:X |\n+--------+    +--------+    +--------+\n\n\nOperation:\nshift()\n\n\nSteps:\ntemp = head\nhead = head.next\nhead.prev = X\ntemp.next = X\n\n\nAfter:\n\nhead                tail\n |                   |\n v                   v\n+--------+    +--------+\n| val:20 |    | val:30 |\n| prev:X |<---| prev:20|\n| next:30|--->| next:X |\n+--------+    +--------+\n\n\nReturned Node:\n\ntemp\n |\n v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\n\n========================================\nONE-LINE INTUITION\n========================================\n\nshift = remove head\nmove head forward\nbreak backward link\n\nTIME COMPLEXITY: O(1)\nNO TRAVERSAL\n========================================",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "========================================\nDOUBLY LINKED LIST — SHIFT INTUITION\n========================================\n\n\nCASE 1: EMPTY LIST\n------------------\n\nBefore:\n\nhead → X\ntail → X\n\n\nOperation:\nshift()\n\n\nAfter:\n\nhead → X\ntail → X\n\nreturn → undefined\n\n\n\n========================================\n\n\nCASE 2: SINGLE NODE\n------------------\n\nBefore:\n\nhead        tail\n |           |\n v           v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\nOperation:\nshift()\n\n\nSteps:\ntemp = head\nhead = X\ntail = X\n\n\nAfter:\n\nhead → X\ntail → X\n\n\nReturned Node:\n\ntemp\n |\n v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\n\n========================================\n\n\nCASE 3: MULTIPLE NODES\n---------------------\n\nBefore:\n\nhead                        tail\n |                           |\n v                           v\n+--------+    +--------+    +--------+\n| val:10 |    | val:20 |    | val:30 |\n| prev:X |<---| prev:10|<---| prev:20|\n| next:20|--->| next:30|--->| next:X |\n+--------+    +--------+    +--------+\n\n\nOperation:\nshift()\n\n\nSteps:\ntemp = head\nhead = head.next\nhead.prev = X\ntemp.next = X\n\n\nAfter:\n\nhead                tail\n |                   |\n v                   v\n+--------+    +--------+\n| val:20 |    | val:30 |\n| prev:X |<---| prev:20|\n| next:30|--->| next:X |\n+--------+    +--------+\n\n\nReturned Node:\n\ntemp\n |\n v\n+--------+\n| val:10 |\n| prev:X |\n| next:X |\n+--------+\n\n\n\n========================================\nONE-LINE INTUITION\n========================================\n\nshift = remove head\nmove head forward\nbreak backward link\n\nTIME COMPLEXITY: O(1)\nNO TRAVERSAL\n========================================",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
