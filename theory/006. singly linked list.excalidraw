      "updated": 1758351972005,
      "link": null,
      "locked": false,
      "text": "- linked list:\n    - data structure: none contiguous ds\n    - memory allocation: typically allocated one by one to\n    individual elements\n    - insertion/deletion: efficient\n    - access: sequential\n- array:\n    - data structure: contiguous\n    - mameory allocation: typically allocated to the whole array\n    - insertion/deletion: efficient\n    - access: random",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- linked list:\n    - data structure: none contiguous ds\n    - memory allocation: typically allocated one by one to\n    individual elements\n    - insertion/deletion: efficient\n    - access: sequential\n- array:\n    - data structure: contiguous\n    - mameory allocation: typically allocated to the whole array\n    - insertion/deletion: efficient\n    - access: random",
      "autoResize": true,
