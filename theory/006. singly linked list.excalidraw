    {
      "id": "GA7tJwbpbHs8KdkXicmeq",
      "type": "text",
      "x": 1753.5004577636719,
      "y": 145,
      "width": 692.9990234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
