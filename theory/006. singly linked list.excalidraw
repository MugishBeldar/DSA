    },
    {
      "id": "xRqCyql-Ilr9u_8T3uQjA",
      "type": "text",
      "x": 5279.693518161774,
      "y": 262.08752155303955,
      "width": 813.9989013671875,
      "height": 4200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2h",
      "roundness": null,
      "seed": 976934791,
      "version": 405,
      "versionNonce": 1066457257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758351815518,
      "link": null,
      "locked": false,
      "text": "// K-Way Merge - Multiple Approaches with Analysis\n\n// Approach 1: Naive Sequential Merging\n/*\nALGORITHM: Merge lists one by one\nTIME COMPLEXITY: O(k²n) where k = number of lists, n = average length\nSPACE COMPLEXITY: O(1)\n\nMATHEMATICAL ANALYSIS:\nMerge 1st and 2nd: O(2n)\nMerge result with 3rd: O(3n)  \n...\nMerge result with kth: O(kn)\nTotal: O(n(2 + 3 + ... + k)) = O(n × k(k+1)/2) = O(k²n)\n*/\nfunction mergeKListsNaive(lists) {\n    if (!lists || lists.length === 0) return null;\n    \n    let result = lists[0];\n    for (let i = 1; i < lists.length; i++) {\n        result = mergeTwoLists(result, lists[i]);\n    }\n    return result;\n}\n\n// Approach 2: Divide and Conquer\n/*\nALGORITHM: Merge pairs recursively like merge sort\nTIME COMPLEXITY: O(kn log k)\nSPACE COMPLEXITY: O(log k) for recursion\n\nMATHEMATICAL ANALYSIS:\nLevel 1: k/2 merges, each O(2n) = O(kn)\nLevel 2: k/4 merges, each O(4n) = O(kn)\n...\nTotal levels: log k\nTotal time: O(kn log k)\n*/\nfunction mergeKListsDivideConquer(lists) {\n    if (!lists || lists.length === 0) return null;\n    \n    while (lists.length > 1) {\n        let mergedLists = [];\n        \n        for (let i = 0; i < lists.length; i += 2) {\n            let l1 = lists[i];\n            let l2 = i + 1 < lists.length ? lists[i + 1] : null;\n            mergedLists.push(mergeTwoLists(l1, l2));\n        }\n        \n        lists = mergedLists;\n    }\n    \n    return lists[0];\n}\n\n// Approach 3: Priority Queue (Min-Heap)\n/*\nALGORITHM: Use min-heap to always get smallest element\nTIME COMPLEXITY: O(kn log k)\nSPACE COMPLEXITY: O(k) for heap\n\nMATHEMATICAL ANALYSIS:\n- Initialize heap with k elements: O(k)\n- Extract min and insert next: O(log k) per operation\n- Total operations: kn (total elements)\n- Total time: O(kn log k)\n*/\nclass MinHeap {\n    constructor() {\n        this.heap = [];\n    }\n    \n    insert(node) {\n        this.heap.push(node);\n        this.bubbleUp(this.heap.length - 1);\n    }\n    \n    extractMin() {\n        if (this.heap.length === 0) return null;\n        if (this.heap.length === 1) return this.heap.pop();\n        \n        let min = this.heap[0];\n        this.heap[0] = this.heap.pop();\n        this.bubbleDown(0);\n        return min;\n    }\n    \n    bubbleUp(index) {\n        while (index > 0) {\n            let parentIndex = Math.floor((index - 1) / 2);\n            if (this.heap[parentIndex].val <= this.heap[index].val) break;\n            \n            [this.heap[parentIndex], this.heap[index]] = \n            [this.heap[index], this.heap[parentIndex]];\n            index = parentIndex;\n        }\n    }\n    \n    bubbleDown(index) {\n        while (true) {\n            let leftChild = 2 * index + 1;\n            let rightChild = 2 * index + 2;\n            let smallest = index;\n            \n            if (leftChild < this.heap.length && \n                this.heap[leftChild].val < this.heap[smallest].val) {\n                smallest = leftChild;\n            }\n            \n            if (rightChild < this.heap.length && \n                this.heap[rightChild].val < this.heap[smallest].val) {\n                smallest = rightChild;\n            }\n            \n            if (smallest === index) break;\n            \n            [this.heap[index], this.heap[smallest]] = \n            [this.heap[smallest], this.heap[index]];\n            index = smallest;\n        }\n    }\n}\n\nfunction mergeKListsHeap(lists) {\n    let heap = new MinHeap();\n    let dummy = { next: null };\n    let current = dummy;\n    \n    // Initialize heap with first node of each list\n    for (let list of lists) {\n        if (list) heap.insert(list);\n    }\n    \n    while (heap.heap.length > 0) {\n        let minNode = heap.extractMin();\n        current.next = minNode;\n        current = current.next;\n        \n        if (minNode.next) {\n            heap.insert(minNode.next);\n        }\n    }\n    \n    return dummy.next;\n}\n\n// Comparison Table\nconst approachComparison = {\n    naive: {\n        time: \"O(k²n)\",\n        space: \"O(1)\",\n        pros: [\"Simple implementation\", \"Minimal space\"],\n        cons: [\"Quadratic in k\", \"Poor for large k\"]\n    },\n    divideConquer: {\n        time: \"O(kn log k)\",\n        space: \"O(log k)\",\n        pros: [\"Optimal time\", \"Good cache locality\"],\n        cons: [\"Recursive overhead\", \"Complex implementation\"]\n    },\n    heap: {\n        time: \"O(kn log k)\",\n        space: \"O(k)\",\n        pros: [\"Intuitive\", \"Good for streaming\"],\n        cons: [\"Heap overhead\", \"Poor cache locality\"]\n    }\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// K-Way Merge - Multiple Approaches with Analysis\n\n// Approach 1: Naive Sequential Merging\n/*\nALGORITHM: Merge lists one by one\nTIME COMPLEXITY: O(k²n) where k = number of lists, n = average length\nSPACE COMPLEXITY: O(1)\n\nMATHEMATICAL ANALYSIS:\nMerge 1st and 2nd: O(2n)\nMerge result with 3rd: O(3n)  \n...\nMerge result with kth: O(kn)\nTotal: O(n(2 + 3 + ... + k)) = O(n × k(k+1)/2) = O(k²n)\n*/\nfunction mergeKListsNaive(lists) {\n    if (!lists || lists.length === 0) return null;\n    \n    let result = lists[0];\n    for (let i = 1; i < lists.length; i++) {\n        result = mergeTwoLists(result, lists[i]);\n    }\n    return result;\n}\n\n// Approach 2: Divide and Conquer\n/*\nALGORITHM: Merge pairs recursively like merge sort\nTIME COMPLEXITY: O(kn log k)\nSPACE COMPLEXITY: O(log k) for recursion\n\nMATHEMATICAL ANALYSIS:\nLevel 1: k/2 merges, each O(2n) = O(kn)\nLevel 2: k/4 merges, each O(4n) = O(kn)\n...\nTotal levels: log k\nTotal time: O(kn log k)\n*/\nfunction mergeKListsDivideConquer(lists) {\n    if (!lists || lists.length === 0) return null;\n    \n    while (lists.length > 1) {\n        let mergedLists = [];\n        \n        for (let i = 0; i < lists.length; i += 2) {\n            let l1 = lists[i];\n            let l2 = i + 1 < lists.length ? lists[i + 1] : null;\n            mergedLists.push(mergeTwoLists(l1, l2));\n        }\n        \n        lists = mergedLists;\n    }\n    \n    return lists[0];\n}\n\n// Approach 3: Priority Queue (Min-Heap)\n/*\nALGORITHM: Use min-heap to always get smallest element\nTIME COMPLEXITY: O(kn log k)\nSPACE COMPLEXITY: O(k) for heap\n\nMATHEMATICAL ANALYSIS:\n- Initialize heap with k elements: O(k)\n- Extract min and insert next: O(log k) per operation\n- Total operations: kn (total elements)\n- Total time: O(kn log k)\n*/\nclass MinHeap {\n    constructor() {\n        this.heap = [];\n    }\n    \n    insert(node) {\n        this.heap.push(node);\n        this.bubbleUp(this.heap.length - 1);\n    }\n    \n    extractMin() {\n        if (this.heap.length === 0) return null;\n        if (this.heap.length === 1) return this.heap.pop();\n        \n        let min = this.heap[0];\n        this.heap[0] = this.heap.pop();\n        this.bubbleDown(0);\n        return min;\n    }\n    \n    bubbleUp(index) {\n        while (index > 0) {\n            let parentIndex = Math.floor((index - 1) / 2);\n            if (this.heap[parentIndex].val <= this.heap[index].val) break;\n            \n            [this.heap[parentIndex], this.heap[index]] = \n            [this.heap[index], this.heap[parentIndex]];\n            index = parentIndex;\n        }\n    }\n    \n    bubbleDown(index) {\n        while (true) {\n            let leftChild = 2 * index + 1;\n            let rightChild = 2 * index + 2;\n            let smallest = index;\n            \n            if (leftChild < this.heap.length && \n                this.heap[leftChild].val < this.heap[smallest].val) {\n                smallest = leftChild;\n            }\n            \n            if (rightChild < this.heap.length && \n                this.heap[rightChild].val < this.heap[smallest].val) {\n                smallest = rightChild;\n            }\n            \n            if (smallest === index) break;\n            \n            [this.heap[index], this.heap[smallest]] = \n            [this.heap[smallest], this.heap[index]];\n            index = smallest;\n        }\n    }\n}\n\nfunction mergeKListsHeap(lists) {\n    let heap = new MinHeap();\n    let dummy = { next: null };\n    let current = dummy;\n    \n    // Initialize heap with first node of each list\n    for (let list of lists) {\n        if (list) heap.insert(list);\n    }\n    \n    while (heap.heap.length > 0) {\n        let minNode = heap.extractMin();\n        current.next = minNode;\n        current = current.next;\n        \n        if (minNode.next) {\n            heap.insert(minNode.next);\n        }\n    }\n    \n    return dummy.next;\n}\n\n// Comparison Table\nconst approachComparison = {\n    naive: {\n        time: \"O(k²n)\",\n        space: \"O(1)\",\n        pros: [\"Simple implementation\", \"Minimal space\"],\n        cons: [\"Quadratic in k\", \"Poor for large k\"]\n    },\n    divideConquer: {\n        time: \"O(kn log k)\",\n        space: \"O(log k)\",\n        pros: [\"Optimal time\", \"Good cache locality\"],\n        cons: [\"Recursive overhead\", \"Complex implementation\"]\n    },\n    heap: {\n        time: \"O(kn log k)\",\n        space: \"O(k)\",\n        pros: [\"Intuitive\", \"Good for streaming\"],\n        cons: [\"Heap overhead\", \"Poor cache locality\"]\n    }\n};",
      "autoResize": true,
      "lineHeight": 1.25
