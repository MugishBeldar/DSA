    {
      "id": "9Kxxv9ZjXDMDU23SRK_y4",
      "type": "text",
      "x": 4459.694006443024,
      "y": 237.08752155303955,
      "width": 780.9990234375,
      "height": 2250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Z",
      "roundness": null,
      "seed": 1045332247,
      "version": 986,
      "versionNonce": 1795687225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758090312789,
      "link": null,
      "locked": false,
      "text": "// Merge Sort vs QuickSort Analysis for Linked Lists\n/*\nMERGE SORT ADVANTAGES:\n1. Stable sorting algorithm\n2. Guaranteed O(n log n) time complexity\n3. O(1) space complexity (no extra arrays needed)\n4. No random access required (perfect for linked lists)\n\nQUICKSORT DISADVANTAGES:\n1. Requires random access for efficient partitioning\n2. O(n²) worst case when pivot is always min/max\n3. Partitioning around pivot is O(n) with O(n) space for linked lists\n4. Not stable without extra space\n\nMATHEMATICAL ANALYSIS:\nT(n) = 2T(n/2) + O(n)  [merge operation]\nBy Master Theorem: T(n) = O(n log n)\nSpace: O(log n) for recursion stack, O(1) auxiliary space\n*/\n\n// Optimal Merge Sort Implementation\nfunction mergeSortLinkedList(head) {\n    // Base case\n    if (!head || !head.next) return head;\n    \n    // Find middle using Floyd's algorithm - O(n/2)\n    let middle = findMiddle(head);\n    let nextToMiddle = middle.next;\n    middle.next = null; // Split the list\n    \n    // Recursively sort both halves\n    let left = mergeSortLinkedList(head);\n    let right = mergeSortLinkedList(nextToMiddle);\n    \n    // Merge sorted halves - O(n)\n    return mergeSortedLists(left, right);\n}\n\nfunction findMiddle(head) {\n    if (!head) return head;\n    \n    let slow = head, fast = head, prev = null;\n    \n    while (fast && fast.next) {\n        prev = slow;\n        slow = slow.next;\n        fast = fast.next.next;\n    }\n    \n    return prev; // Return node before middle for proper splitting\n}\n\nfunction mergeSortedLists(l1, l2) {\n    let dummy = { next: null };\n    let current = dummy;\n    \n    while (l1 && l2) {\n        if (l1.val <= l2.val) {\n            current.next = l1;\n            l1 = l1.next;\n        } else {\n            current.next = l2;\n            l2 = l2.next;\n        }\n        current = current.next;\n    }\n    \n    // Attach remaining nodes\n    current.next = l1 || l2;\n    \n    return dummy.next;\n}\n\n// Complexity Analysis\nconst complexityAnalysis = {\n    time: {\n        best: \"O(n log n)\",\n        average: \"O(n log n)\", \n        worst: \"O(n log n)\",\n        explanation: \"Each level processes n nodes, log n levels total\"\n    },\n    space: {\n        auxiliary: \"O(1)\",\n        recursionStack: \"O(log n)\",\n        total: \"O(log n)\",\n        explanation: \"No extra arrays, only recursion stack\"\n    },\n    stability: \"Yes - equal elements maintain relative order\",\n    inPlace: \"Yes - only rearranges existing nodes\"\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Merge Sort vs QuickSort Analysis for Linked Lists\n/*\nMERGE SORT ADVANTAGES:\n1. Stable sorting algorithm\n2. Guaranteed O(n log n) time complexity\n3. O(1) space complexity (no extra arrays needed)\n4. No random access required (perfect for linked lists)\n\nQUICKSORT DISADVANTAGES:\n1. Requires random access for efficient partitioning\n2. O(n²) worst case when pivot is always min/max\n3. Partitioning around pivot is O(n) with O(n) space for linked lists\n4. Not stable without extra space\n\nMATHEMATICAL ANALYSIS:\nT(n) = 2T(n/2) + O(n)  [merge operation]\nBy Master Theorem: T(n) = O(n log n)\nSpace: O(log n) for recursion stack, O(1) auxiliary space\n*/\n\n// Optimal Merge Sort Implementation\nfunction mergeSortLinkedList(head) {\n    // Base case\n    if (!head || !head.next) return head;\n    \n    // Find middle using Floyd's algorithm - O(n/2)\n    let middle = findMiddle(head);\n    let nextToMiddle = middle.next;\n    middle.next = null; // Split the list\n    \n    // Recursively sort both halves\n    let left = mergeSortLinkedList(head);\n    let right = mergeSortLinkedList(nextToMiddle);\n    \n    // Merge sorted halves - O(n)\n    return mergeSortedLists(left, right);\n}\n\nfunction findMiddle(head) {\n    if (!head) return head;\n    \n    let slow = head, fast = head, prev = null;\n    \n    while (fast && fast.next) {\n        prev = slow;\n        slow = slow.next;\n        fast = fast.next.next;\n    }\n    \n    return prev; // Return node before middle for proper splitting\n}\n\nfunction mergeSortedLists(l1, l2) {\n    let dummy = { next: null };\n    let current = dummy;\n    \n    while (l1 && l2) {\n        if (l1.val <= l2.val) {\n            current.next = l1;\n            l1 = l1.next;\n        } else {\n            current.next = l2;\n            l2 = l2.next;\n        }\n        current = current.next;\n    }\n    \n    // Attach remaining nodes\n    current.next = l1 || l2;\n    \n    return dummy.next;\n}\n\n// Complexity Analysis\nconst complexityAnalysis = {\n    time: {\n        best: \"O(n log n)\",\n        average: \"O(n log n)\", \n        worst: \"O(n log n)\",\n        explanation: \"Each level processes n nodes, log n levels total\"\n    },\n    space: {\n        auxiliary: \"O(1)\",\n        recursionStack: \"O(log n)\",\n        total: \"O(log n)\",\n        explanation: \"No extra arrays, only recursion stack\"\n    },\n    stability: \"Yes - equal elements maintain relative order\",\n    inPlace: \"Yes - only rearranges existing nodes\"\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
